# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/jewellery_feedback_db

# Redis Configuration (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=replace_with_a_secure_jwt_secret_min_32_chars
JWT_EXPIRES_IN=1d

# Integration API Key (Billing POS to Feedback System)
BILLING_INTEGRATION_API_KEY=replace_with_secure_billing_api_key

# Voice Telephony Provider Configuration
VOICE_PROVIDER=mock # options: mock, retell, vapi, custom
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_WEBHOOK_SECRET=
CUSTOM_AI_API_KEY=
CUSTOM_AI_API_URL=https://prod-api.ringg.ai/ca/api/v0/calling/outbound/individual
CUSTOM_AI_AGENT_ID=
CUSTOM_AI_CALLER_ID=
CUSTOM_AI_WEBHOOK_SECRET=

# Calling Window Rules (IST)
CALLING_HOURS_START=10:00 # 10:00 AM IST
CALLING_HOURS_END=20:00   # 08:00 PM IST
TIMEZONE=Asia/Kolkata
CALL_DELAY_MINUTES=15
MAX_CALL_ATTEMPTS=2
RETRY_DELAY_MINUTES=30

